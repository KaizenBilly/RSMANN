Options -Indexes

# ── Private files: never served (repo is deployed whole by git) ──
# Internal notes, docs, git metadata, dotfiles, env/config and backups
RedirectMatch 404 ^/job-notes(/.*)?$
RedirectMatch 404 /\.(?!well-known/)
RedirectMatch 404 \.(md|env|ini|log|sql|bak|zip|sh|json|lock|yml|yaml)$
RedirectMatch 404 ^/(?!robots\.txt$)[^/]+\.txt$
RewriteEngine On

# Remove .html extension
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^([^\.]+)$ $1.html [NC,L]

# Redirect .html URLs to clean URLs
RewriteCond %{THE_REQUEST} /([^.]+)\.html [NC]
RewriteRule ^ /%1 [NC,L,R=301]
